{
    "name": "@starframe/view-print",
    "version": "0.1.1",
    "description": "AI tool for extracting precise layout graphs from web pages via Playwright",
    "type": "module",
    "main": "./dist/index.js",
    "bin": {
        "viewprint": "./dist/src/cli.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest run",
        "lint": "tsc --noEmit"
    },
    "keywords": [
        "playwright",
        "layout",
        "css",
        "dom",
        "ai",
        "cli"
    ],
    "author": "Starframe",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/starframe-dev/view-print.git"
    },
    "bugs": {
        "url": "https://github.com/starframe-dev/view-print/issues"
    },
    "homepage": "https://github.com/starframe-dev/view-print#readme",
    "dependencies": {
        "commander": "^12.1.0",
        "playwright": "^1.45.0"
    },
    "devDependencies": {
        "@types/node": "^20.14.0",
        "memfs": "^4.64.0",
        "typescript": "^5.5.0",
        "vitest": "^2.0.0"
    }
}
