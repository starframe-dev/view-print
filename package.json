{
    "name": "@starframe/view-print",
    "version": "0.2.0",
    "description": "AI tool for extracting precise layout graphs from web pages via Playwright",
    "type": "module",
    "main": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js"
        }
    },
    "files": [
        "dist/package.json",
        "dist/src/*.js",
        "dist/src/*.d.ts",
        "README.md",
        "LICENSE"
    ],
    "bin": {
        "viewprint": "./dist/src/cli.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc && node scripts/copy-package-metadata.mjs",
        "pretest": "pnpm run build",
        "prepack": "pnpm run build",
        "dev": "tsc --watch",
        "test": "vitest run",
        "lint": "tsc --noEmit",
        "reinstall-global": "pnpm run build && (viewprint daemon stop || true) && pnpm add -g file:. --force",
        "deploy": "pnpm run lint && pnpm run test && pnpm run build && pnpm run reinstall-global"
    },
    "keywords": [
        "playwright",
        "layout",
        "css",
        "dom",
        "ai",
        "cli"
    ],
    "author": "Starframe",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/starframe-dev/view-print.git"
    },
    "bugs": {
        "url": "https://github.com/starframe-dev/view-print/issues"
    },
    "homepage": "https://github.com/starframe-dev/view-print#readme",
    "dependencies": {
        "@modelcontextprotocol/server": "^2.3.1",
        "commander": "^12.1.0",
        "playwright": "^1.45.0",
        "zod": "^4.6.5"
    },
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@11.9.0",
    "devDependencies": {
        "@types/node": "^20.14.0",
        "memfs": "^4.64.0",
        "typescript": "^5.5.0",
        "vite": "^7.3.7",
        "vitest": "^4.1.11"
    }
}
